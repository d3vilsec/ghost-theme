{{#if pagination}}
<nav class="pagination">
  {{#if prev}}
  <a href="{{prev}}">&larr; newer posts</a>
  {{else}}
  <span></span>
  {{/if}}
  <span class="pagination-info">{{page}} / {{pages}}</span>
  {{#if next}}
  <a href="{{next}}">older posts &rarr;</a>
  {{else}}
  <span></span>
  {{/if}}
</nav>
{{/if}}
